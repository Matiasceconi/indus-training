{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "focalPointX": {
      "type": "number",
      "description": "Punto focal horizontal 0-1 para recorte de imagen",
      "default": 0.5
    },
    "focalPointY": {
      "type": "number",
      "description": "Punto focal vertical 0-1 para recorte de imagen",
      "default": 0.5
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}